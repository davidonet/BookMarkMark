{
	"name": "bookmarkmark",
	"private": true,
	"version": "1.0.0",
	"description": "A neo-brutalist sidekick to keep track of books you heard about, order them from your local bookstore, and remember what you own.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"packageManager": "pnpm@12.3.4",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.3.4",
			"onFail": "download"
		}
	},
	"dependencies": {
		"@fontsource-variable/jost": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"@lucide/svelte": "^1.43.0",
		"@vercel/functions": "^3.9.7",
		"mongodb": "^7.6.0"
	}
}
