# MongoDB Atlas connection string and database name
MONGODB_URI=
MONGO_DB=books

# 4-digit PIN that unlocks the app. Required in production.
# When it is missing in `pnpm dev`, the PIN defaults to 1234.
APP_PIN=

# Optional: Google Books API key (Books API enabled, key restricted to it).
# Without it, search uses Open Library.
GOOGLEBOOKS_API_KEY=

# Optional: secret used to sign the session cookie.
# Defaults to a value derived from MONGODB_URI. Changing APP_PIN logs every device out.
AUTH_SECRET=
